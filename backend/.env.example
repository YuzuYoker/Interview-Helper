# 复制为根目录 .env 并填写

# 视觉（Qwen-VL-Max，DashScope）
DASHSCOPE_API_KEY=
VISION_MODEL=qwen-vl-max

# LLM（DeepSeek，OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL=deepseek-v4-flash

# Qdrant
QDRANT_MODE=local            # local | server
QDRANT_PATH=backend/data/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_documents

# 嵌入模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=auto        # auto | cuda | cpu
HF_ENDPOINT=https://hf-mirror.com
# docker compose 本地验证用：宿主 HF 模型缓存路径（只读挂载到容器 /hf-cache）。
# 只在本地 .env 设置（gitignore 不提交），勿写死到 docker-compose.yml；未配置则改用 named volume。
HF_CACHE_DIR=

# 分块与检索
CHUNK_SIZE=450
CHUNK_OVERLAP=100
TOP_K=4

# 联网搜索（后端作为 MCP 客户端连接 fetch MCP server；搜索=抓 Bing 结果页解析，无需 API key）
WEB_SEARCH_ENABLED=true
WEB_FETCH_COMMAND=python -m mcp_server_fetch    # 解析为当前解释器；不用 uvx（其隔离环境会装 mcp 2.x，与 fetch 不兼容）
WEB_FETCH_IGNORE_ROBOTS=true              # 忽略 robots.txt（默认 UA 会被大量站点拒绝）
WEB_SEARCH_AUTO=true                      # 问题含时效敏感词（最新/今年/趋势…）时自动触发
WEB_SEARCH_MAX_PAGES=3                    # 抓取正文的网页数
WEB_SEARCH_PAGE_LENGTH=4000               # 每页正文截断字符数
WEB_SEARCH_TIMEOUT=20                     # 单次搜索+抓取整体超时（秒）
WEB_CACHE_TTL=1800                        # 搜索结果页级缓存（秒）

# 其他
UPLOAD_DIR=backend/data/uploads
